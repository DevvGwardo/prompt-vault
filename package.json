{
  "name": "prompt-vault",
  "productName": "Prompt Vault",
  "version": "0.1.5",
  "description": "Capture, score, and search prompts from Claude Code, Cursor, Codex, Grok, and cursor-agent.",
  "main": "main.js",
  "author": "Prompt Vault",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder --mac --arm64",
    "dist:dir": "electron-builder --mac --arm64 --dir",
    "dist:all": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:mas": "electron-builder --mac mas --arm64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^25.0.0",
    "patch-package": "^8.0.0"
  },
  "build": {
    "appId": "com.promptvault.app",
    "productName": "Prompt Vault",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "analyzer.js",
      "db.js",
      "lib/**/*",
      "renderer/**/*",
      "hook/**/*",
      "assets/tray/**/*",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "mas": {
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/rebuild": "4.2.0"
    }
  }
}
